# Copy to .env and fill in. Never commit .env.
ATRG_PORT=5000

# Automatic document reading (Google Gemini). Leave the key empty to work offline with manual entry.
GEMINI_API_KEY=
AI_ENABLED=true
# auto = try Google AI Studio first, then Vertex AI express mode
GEMINI_USE_VERTEX=auto
# empty = newest available gemini-X.Y-flash / gemini-X.Y-pro
GEMINI_MODEL_FAST=
GEMINI_MODEL_PRO=
